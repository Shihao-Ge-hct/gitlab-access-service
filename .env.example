# Docker Compose host binding. Use an internal server address only when the
# server firewall allows access from approved callers.
SERVICE_BIND_ADDRESS=127.0.0.1
SERVICE_PORT=8080
SERVICE_NETWORK_NAME=gitlab-access-service-net
SERVICE_DOCKER_SUBNET=10.254.0.0/24

GITLAB_BASE_URL=https://gitlab.hc.com
GITLAB_PROJECT=infras/ai_infra/gitKrab
GITLAB_PIPELINE_REF=main
PIPELINE_POLL_SECONDS=10
PIPELINE_TIMEOUT_MINUTES=120

# This must match the issuer claim in caller JWTs.
AUTH_JWT_ISSUER=https://sso.example.internal
AUTH_JWT_AUDIENCE=gitlab-access-service
